      "WLD/USDT:USDT",
      "SUI/USDT:USDT",
      "ADA/USDT:USDT",
      "SEI/USDT:USDT",
      "AVAX/USDT:USDT",
      "ENA/USDT:USDT",
      "LINK/USDT:USDT",
      "FIL/USDT:USDT",
      "XLM/USDT:USDT",
      "BCH/USDT:USDT",
      "ONDO/USDT:USDT",
      "TRUMP/USDT:USDT",
      "AAVE/USDT:USDT",
      "DOT/USDT:USDT",
      "PENGU/USDT:USDT",
      "LTC/USDT:USDT",
      "TRX/USDT:USDT",
      "FET/USDT:USDT",
      "UNI/USDT:USDT",
      "INJ/USDT:USDT",
      "DASH/USDT:USDT",
      "B/USDT:USDT",
