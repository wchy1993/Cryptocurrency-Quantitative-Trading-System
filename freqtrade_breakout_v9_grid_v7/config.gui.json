      "1000SHIB/USDT:USDT",
      "APE/USDT:USDT",
      "XMR/USDT:USDT",
      "APT/USDT:USDT",
      "WIF/USDT:USDT",
      "ICP/USDT:USDT",
      "ETC/USDT:USDT",
      "VIRTUAL/USDT:USDT",
      "HBAR/USDT:USDT",
      "RENDER/USDT:USDT",
      "CRV/USDT:USDT",
      "JTO/USDT:USDT",
      "OP/USDT:USDT",
      "CHZ/USDT:USDT",
      "1000BONK/USDT:USDT"
