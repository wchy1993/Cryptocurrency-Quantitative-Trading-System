  "api_server": {
    "enabled": false,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "disabled-local-gui-jwt-key-0000000001",
    "ws_token": "disabled-local-gui-ws-token-0000000001",
